{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!sitemap\\.xml|sitemaps\\.xml|robots\\.txt|llms\\.txt|ai\\.txt|humans\\.txt|manifest\\.webmanifest|google[^/]+\\.html|.*\\.(?:png|jpe?g|gif|webp|ico|svg|css|js|map|txt|xml|webmanifest)$).*)",
      "destination": "/index.html"
    }
  ]
}
